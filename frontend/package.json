{
  "name": "@moi952/decky-plugin-toolkit",
  "version": "0.1.0",
  "description": "Reusable Settings-page building blocks for moi952's Decky Loader plugins: plugin self-update (check + one-click install), \"my other plugins\" list, what's-new history. Pairs with the Python package in this same repo's decky_plugin_toolkit/.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsc"
  },
  "peerDependencies": {
    "@decky/api": ">=1.0.0",
    "@decky/ui": ">=4.0.0",
    "@moi952/decky-ui-kit": ">=0.5.0",
    "react": ">=18.0.0",
    "react-icons": ">=5.0.0",
    "react-i18next": ">=13.0.0",
    "i18next": ">=23.0.0"
  },
  "devDependencies": {
    "@decky/api": "^1.1.3",
    "@decky/ui": "^4.11.1",
    "@moi952/decky-ui-kit": "^0.5.0",
    "@types/react": "19.1.1",
    "i18next": "^23.15.1",
    "react": "^18.3.1",
    "react-i18next": "^14.1.3",
    "react-icons": "^5.3.0",
    "typescript": "^5.6.2"
  },
  "author": "moi952",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moi952/decky-plugin-toolkit.git",
    "directory": "frontend"
  },
  "keywords": ["decky", "decky-loader", "steam-deck", "plugin-update", "settings"]
}
